---
import Base from '../layouts/Base.astro';
import { company } from '../data/site';
---

<Base title="견적 문의" description="레어젠 대표번호와 이메일로 제품 견적과 상담을 문의해 주세요.">
  <section class="container contact">
    <div class="contact__info">
      <p class="eyebrow rise-1">견적 문의</p>
      <h1 class="display"><span class="line"><span>필요한 제품을</span></span><span class="line"><span>알려 주세요</span></span></h1>
      <p class="lede lede--lg rise-2">대표번호나 이메일로 연락해 주시면 담당자가 안내해 드립니다.</p>
      <dl class="contact-list rise-3">
        <div><dt>대표번호</dt><dd><a href={`tel:${company.tel}`}>{company.tel}</a></dd></div>
        <div><dt>제품 견적 및 기타 문의</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
        <div><dt>주소</dt><dd>{company.address}</dd></div>
      </dl>
    </div>
    <div class="preparing rise-2">
      <span class="preparing__icon">
        <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4zM4 7l8 6 8-6"></path></svg>
      </span>
      <h2>온라인 문의 준비중</h2>
      <p>더 편리한 문의 창구를 준비하고 있습니다.<br />그동안 대표번호나 이메일을 이용해 주세요.</p>
    </div>
  </section>
</Base>
